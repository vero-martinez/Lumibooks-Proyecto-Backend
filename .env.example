# ==========================================
# Lumibooks Backend - Environment Variables
# ==========================================
# Este archivo sirve como referencia de las
# variables necesarias para ejecutar el proyecto.
#
# Configure estas variables en su sistema
# operativo o entorno de ejecución.
#
# No subir credenciales reales a GitHub.
# ==========================================

# Database Configuration
DB_URL=
DB_USER=
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Correo (SMTP Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Código de recuperación de contraseña
RESET_CODE_EXPIRATION_MINUTES=10
RESET_CODE_MAX_ATTEMPTS=5

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# COOKIES 
COOKIE_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Perfil activo (dev/prod)
SPRING_PROFILES_ACTIVE=dev